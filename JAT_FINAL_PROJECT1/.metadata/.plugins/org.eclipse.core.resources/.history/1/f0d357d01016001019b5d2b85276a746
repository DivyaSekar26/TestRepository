import pageObjects.HomePage;
import pageObjects.SearchHotelPage;
import testBase.BaseClass;

public class TS002_SearchHotelTest extends BaseClass {
	
	HomePage hp;
	SearchHotelPage sp;
	
	@BeforeClass
	public void setUp() throws IOException
	{
	FileReader fr=new FileReader(System.getProperty("user.dir")+ "\\src\\test\\resources\\config.properties");
	Properties pr=new Properties();
	pr.load(fr);
	hp=new HomePage(BaseClass.driver);	
	sp=new SearchHotelPage(BaseClass.driver);
	hp.passCredentials(System.getProperty("USERNAME"), System.getProperty("PASSWORD"));
	hp.clickLogin();
	}
	
	@Test
	public void verifyWelcomeText()
	{
	if(sp.valWelcomeTxt.getText().equals("Hello divyasekar1234!"))
	{
		Assert.assertTrue(true);
	}
	else
	{
		takeScreenshot();
		Assert.fail();
	}
	}
	
	@Test
	public void searchHotelByAllDetails()
	{
		WebElement element=sp.dropdownLocation;
		Select select=new Select(element);
		select.selectByValue("Melbourne");
	}

}
