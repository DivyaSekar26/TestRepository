	@FindBy(id="last_name")
	public WebElement txtLastName;
	
	@FindBy(id="address")
	public WebElement txtAddress;
	
	@FindBy(id="cc_num")
	public WebElement txtCreditCardNum;
	
	@FindBy(id="cc_type")
	public WebElement dropdownCardType;
	
	@FindBy(id="cc_exp_month")
	public WebElement dropdownExpiryMonth;
	
	@FindBy(id="cc_exp_year")
	public WebElement dropdownExpiryYear;
	
	@FindBy(id="cc_cvv")
	public WebElement txtCVVnum;
	
	@FindBy(id="book_now")
