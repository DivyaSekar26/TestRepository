package testCases;

import java.io.FileReader;
import java.io.IOException;
import java.util.Properties;

import org.testng.annotations.AfterMethod;
import org.testng.annotations.BeforeMethod;
import org.testng.annotations.DataProvider;
import org.testng.annotations.Test;

import pageObjects.BookHotelPage;
import pageObjects.HomePage;
import pageObjects.SearchHotelPage;
import pageObjects.SelectHotelPage;
import testBase.BaseClass;
import utilities.BookingDetailsHelper;

public class TS004_BookHotelTest extends BaseClass {
	HomePage hp;
	SearchHotelPage sp;
	SelectHotelPage sl;
	BookHotelPage bp;
	BookingDetailsHelper bhp = new BookingDetailsHelper();

	@BeforeMethod
	public void setUp() throws IOException {

		FileReader fr = new FileReader(System.getProperty("user.dir") + "\\src\\test\\resources\\config.properties");
		Properties pr = new Properties();
		pr.load(fr);
		hp = new HomePage(BaseClass.driver);
		sp = new SearchHotelPage(BaseClass.driver);
		sl = new SelectHotelPage(BaseClass.driver);
		bp = new BookHotelPage(BaseClass.driver);
		hp.passCredentials(pr.getProperty("USERNAME"), pr.getProperty("PASSWORD"));
		hp.clickLogin();

	}
	@DataProvider(name="bookingdata")
	public Object[][] testData()
	{
		Object[][] data= {{"Brisbane", "Hotel Hervey", "Deluxe", "2", "2", "1", "Tina", "T", "18 cross st", "1234123412341234", "VISA", "1", "2028", "223"},
				{"Adelaide", "Hotel Cornice", "Super Deluxe", "2", "2", "1", "Lina", "L", "10 cross st", "1232123412341234", "MAST", "3", "2030", "111"}};
		return data;
	}

	@Test(priority = 1, dataProvider = "bookingdata" )
	public void verifyBookingByValidDetails(String location, String hotelName, String roomType, String noOfrooms, String numOfadults, String noOfChild,
			String fname, String lname, String address, String ccNum, String cardType,
			String expMonth, String expYear, String cvvNum) {
        bhp.enterHotelDetails(location, hotelName, roomType, noOfrooms, numOfadults, noOfChild);
        sp.clickSubmitBtn();
        sl.selectHotel(0, sl.radioListedHotels);
        sl.clickContinue();
		bhp.enterHotelDetails(fname, lname, address, ccNum, cardType, expMonth,expYear,cvvNum  );
		bp.clickBookNowButton();

	}
	
	@AfterMethod
	public void tearDown()
	{
		driver.quit();
	}

}
